# =====================================================================
#  Production .env template for the Docker / VPS deployment.
#  On the VPS:  cp .env.docker.example .env   then edit the marked lines.
# =====================================================================

APP_NAME="LSPU EIS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# <-- put your VPS IP now, swap to https://yourdomain.com later
APP_URL=http://YOUR_VPS_IP

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# --- Database: host is the compose service name "db" ------------------
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=lspu_eis
DB_USERNAME=lspu_eis
DB_PASSWORD=CHANGE_ME_strong_password
# Used only by the MySQL container for the root account:
DB_ROOT_PASSWORD=CHANGE_ME_different_strong_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Mail: fill with real SMTP when ready ---------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- App-specific (optional) --------------------------------------
# UPLOADS_PATH stays default (public/uploads) unless you know you need it.
# BACKUP_DIR=/var/www/html/storage/app/backups
# BACKUP_RETENTION_DAYS=30
