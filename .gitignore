# User-uploaded content (not source code) — never committed, regenerated
# on disk per-category by App\Core\Uploader on first upload. Lives directly
# under public/uploads (see App\Core\Uploader::basePath()) — no separate
# project-root uploads/ or symlink between them; `ln -s` on Windows without
# an elevated privilege silently falls back to a one-time directory copy
# instead of erroring, which is exactly the kind of failure a symlink-based
# setup here would hide.
/public/uploads/*
!/public/uploads/.htaccess
!/public/uploads/.gitkeep

# Playwright generated output (reports/traces/screenshots/videos from test
# runs) — regenerated on every run, not source.
/playwright-report
/test-results
/tests/Browser/screenshots
/tests/Browser/fixtures/files/not-an-image.txt

Homestead.json
Homestead.yaml
Thumbs.db
